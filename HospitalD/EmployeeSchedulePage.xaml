<Page x:Class="HospitalD.EmployeeSchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HospitalD"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeeSchedulePage" Background="#B2EBF2">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтрации -->
        <WrapPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Фильтр по дате:" Margin="0,0,10,0"/>
                <DatePicker x:Name="DateFilter" Margin="0,0,10,0"/>
                <TextBlock Text="Врач:" Margin="0,0,10,0"/>
                <ComboBox x:Name="DoctorFilterComboBox" Width="200" Margin="0,0,10,0"
                          DisplayMemberPath="FullName" SelectedValuePath="ID_Staff"/>
                <Button Content="Применить" Click="ApplyFilter_Click" Margin="0,0,10,0"/>
                <Button Content="Сегодня" Click="TodayButton_Click" Margin="0,0,10,0"/>
                <Button Content="Сбросить" Click="ResetFilter_Click"/>
            </StackPanel>
        </WrapPanel>

        <!-- Таблица данных -->
        <DataGrid Grid.Row="1" Name="ScheduleDataGrid" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding VisitDate, StringFormat={}{0:dd.MM.yyyy}}" Width="*"/>
                <DataGridTextColumn Header="Пациент" Binding="{Binding Patient.FullName}" Width="*"/>
                <DataGridTextColumn Header="Врач" Binding="{Binding Staff.FullName}" Width="*"/>
                <DataGridTextColumn Header="Диагноз" Binding="{Binding Diagnosis.Name, TargetNullValue='Не указан'}" Width="*"/>
                <DataGridTextColumn Header="Процедура" Binding="{Binding MedicalProcedure.Name, TargetNullValue='Не указана'}" Width="*"/>
                <DataGridTextColumn Header="Примечания" Binding="{Binding Notes}" Width="*"/>
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Завершить" Click="CompleteAppointmentButton_Click" 
                            HorizontalAlignment="Left" Width="80" Background="LightGreen"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>