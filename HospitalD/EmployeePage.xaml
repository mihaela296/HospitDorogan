<Page x:Class="HospitalD.EmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:HospitalD"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="EmployeePage">

    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Style="{StaticResource StackPanelAdmin}">
            <Button Content="Мед.карты" Style="{StaticResource MenuButtonStyle}" Click="MedicalRecords_Click"/>
            <Button Content="Назначить лечение" Style="{StaticResource MenuButtonStyle}" Click="AssignTreatment_Click"/>
            <Button Content="Расписание" Style="{StaticResource MenuButtonStyle}" Click="Schedule_Click"/>
            <Button Content="Пациенты" Style="{StaticResource MenuButtonStyle}" Click="Patients_Click"/>
            <Button Content="Выйти" Style="{StaticResource LogoutButtonStyle}" Click="Logout_Click"/>
        </StackPanel>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </DockPanel>
</Page>